{
  "name": "apix",
  "private": true,
  "version": "0.1.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/validate-release-version.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules/.vite dist src-tauri/target",
    "clean:all": "rm -rf node_modules dist src-tauri/target",
    "reset": "rm -rf node_modules dist src-tauri/target && npm install"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.3.2",
    "@tauri-apps/plugin-upload": "^2.4.0",
    "@tauri-apps/plugin-websocket": "^2.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-json-view-lite": "^2.5.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "conventional-changelog": "^7.2.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "jsdom": "^28.1.0",
    "typescript": "~5.8.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  }
}
